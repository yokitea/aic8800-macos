+                SYSLOG(MODULE_SHORT, "Patched external dongle failed check (forced active) in %s!", path);
+            }
+            if (KernelPatcher::findAndReplace(const_cast<void *>(data), PAGE_SIZE, kLEBufferSizeV1FallbackOriginal, sizeof(kLEBufferSizeV1FallbackOriginal), kLEBufferSizeV1FallbackPatched, sizeof(kLEBufferSizeV1FallbackPatched))) {
+                SYSLOG(MODULE_SHORT, "Patched LE_Read_Buffer_Size_V2 -> V1 fallback in %s!", path);
+            }
+            if (KernelPatcher::findAndReplace(const_cast<void *>(data), PAGE_SIZE, kLEInitMultiAdvFallbackOriginal, sizeof(kLEInitMultiAdvFallbackOriginal), kLEInitMultiAdvFallbackPatched, sizeof(kLEInitMultiAdvFallbackPatched))) {
+                SYSLOG(MODULE_SHORT, "Patched LE_InitMultipleAdvertising -> single-adv fallback in %s!", path);
+            }
